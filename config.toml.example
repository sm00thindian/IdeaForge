# IdeaForge configuration
# Copy to ~/.config/ideaforge/config.toml
#
# Voice memos → meeting notes or song ideas (mode = auto).
# Validate anytime:  ideaforge --validate-config
# Health check:      ideaforge --doctor
#
# ---------------------------------------------------------------------------
# PRESETS (copy the block that matches your machine, then customize below)
# ---------------------------------------------------------------------------
#
# --- meeting-minimal (8 GB Mac, meetings only, fastest) ---
# [whisper]
# model = "tiny"
# [processing]
# mode = "meeting"
# diarize = false
# max_parallel_sessions = 1
# merge_to_mp3 = true
# [creative]
# enabled = false
#
# --- meeting+diarize (16 GB+, named speakers) ---
# [whisper]
# model = "small"
# [processing]
# mode = "meeting"
# diarize = true
# max_parallel_sessions = 1
# # requires HF_TOKEN in env / .env, then ./scripts/install-daemon.sh
#
# --- song-auto (meetings + "song idea" trigger at start of memo) ---
# [processing]
# mode = "auto"
# max_parallel_sessions = 1
# [creative]
# enabled = true
# trigger_phrases = ["song idea", "lyric idea"]
#
# Memory guide:
#   8 GB  → max_parallel_sessions = 1, whisper tiny/base, diarize off
#   16 GB+ → parallel 2 is OK if summarize (Grok) is the bottleneck
# ---------------------------------------------------------------------------

archive = "~/IdeaForge"

# Optional: map volume labels to device profiles (0.8.0+).
# When set, archive paths become ~/IdeaForge/{name}/YYYY-MM-DD/
# and the daemon can process multiple configured devices at once.
# [[devices]]
# name = "office-z28"
# mount_glob = "NO NAME"
# profile = "z28"
# chunk_mode = "gap"           # optional override: gap | silence | fixed_window | none
#
# [[devices]]
# name = "field-recorder"
# mount_glob = "RECORDER"
# profile = "generic_wav"

[llm]
backend = "auto"         # auto | ollama | grok | claude  (auto prefers Grok)
ollama_model = "llama3.1"
grok_model = "grok-4.3"   # grok-4-1-fast-reasoning for faster/cheaper
claude_model = "claude-sonnet-4-20250514"

[whisper]
backend = "auto"         # auto | mlx | faster  (auto uses mlx on Apple Silicon)
model = "small"          # tiny | base | small | medium | large-v3
device = "cpu"           # for faster-whisper fallback: cpu | cuda
compute_type = "int8"
beam_size = 1            # faster-whisper only; 1 is fastest
language = "en"          # force English (omit for auto-detect)

[processing]
mode = "auto"            # meeting | creative | auto (auto = meeting unless keyword trigger)
output_format = "both"   # md | json | both
diarize = false
min_file_size_bytes = 50000
delete_empty_merged_audio = true  # remove *_merged.wav when Whisper finds no speech
merge_chunks = true          # join consecutive recorder splits (e.g. 15 min max)
merge_to_mp3 = true          # after success: *_merged.wav → *_merged.mp3 (sources stay WAV; needs ffmpeg)
merge_mp3_bitrate = "64k"    # speech-friendly mono bitrate for the merge artifact
chunk_mode = "gap"           # gap | silence | fixed_window | none (0.9.0+)
chunk_gap_seconds = 30       # max gap between chunk end and next start
merge_min_chunk_seconds = 600  # prior chunk must be this long to merge (filters short clips)
max_session_seconds = 14400  # 4h cap on multi-chunk merges (Metal ~4 GiB limit; 0 = off)
split_silence_seconds = 3.0  # silence split: min gap between sessions
split_window_seconds = 900   # fixed_window split: segment length in seconds
normalize_audio = true       # convert MP3/FLAC/etc. to WAV via ffmpeg before transcribe
max_parallel_sessions = 1      # 1 = safest (8 GB); use 2+ on 16 GB+ (GPU still serialized)

[creative]
enabled = true
trigger_phrases = ["song idea", "lyric idea"]
scan_chars = 500               # inspect this many chars at transcript start for triggers
temperature = 0.6              # LLM temperature for song-idea mode (meetings use 0.2)
style_merge = "merge"          # merge | memo_wins | pick_first | pick_random
target_duration_minutes = 4.5  # aim for 4–5 minute Suno/Udio song length
rhyme_scheme = "mixed"         # abab | aabb | mixed (per-section)

[creative.suno]
style_default = "acoustic folk, warm male vocal, fingerpicked guitar, intimate"
style_variations = [
  "acoustic folk, 85 BPM, porch-light ambience",
  "indie folk, sparse piano, melancholic female vocal",
]

[creative.udio]
style_default = "folk, mellow, warm, acoustic guitar, intimate vocals"
style_variations = [
  "folk, nostalgic, gentle fingerpicking, sunset mood",
]

[diarization]
# Hugging Face token for pyannote models (or set HF_TOKEN env var)
# hf_token = "hf_..."
min_speakers = 2        # hint for 2-person recordings (optional)
# max_speakers = 2

# Optional: override pyannote labels in the saved transcript (Grok infers names by default)
# [speakers.map]
# SPEAKER_00 = "Kilynn"
# SPEAKER_01 = "Alex"
# library_enabled = true          # reuse embeddings across sessions (1.0.0+)
# library_auto_apply = true       # apply known names during diarization
# library_auto_learn = true       # learn names from manual [speakers.map] overrides
# library_match_threshold = 0.75

[daemon]
poll_interval_seconds = 5   # how often to check /Volumes
settle_seconds = 5          # wait after mount before processing
delete_after_copy = true    # remove recordings from device after verified local copy
unmount_after_ingest = true # eject volume after all files are copied and verified locally
notify = true               # macOS notification when pipeline finishes
sync_device_clock = true    # fix recset.txt before ingest (before unmount)
clock_skew_threshold_seconds = 60  # only write when skew exceeds this
notify_on_failure = false   # macOS alert when a pipeline session fails (opt-in)
log_rotate_enabled = true   # daily rotation when daemon is idle
log_rotate_hour = 2         # local time (0–23); default 2:00 AM
log_rotate_minute = 0
log_rotate_backups = 3      # keep .log.1 … .log.N per file
merged_wav_retain_days = 3  # prune leftover *_merged.wav during daily rotation (0 = off)

# Menu bar progress UI (optional):
#   ./scripts/install-menubar.sh
# Reads ~/Library/Application Support/IdeaForge/status.json

[sync]
# Optional remote archive push after meeting notes are generated (1.0.0+)
enabled = false
# target = "user@nas:/volume/backups/ideaforge"
after_notes = true
scope = "session"    # session | device | archive
# extra_args = ["-az"]

[export]
# Off by default — enable what you use (opt-in)
reminders = false
reminders_list = "IdeaForge"
obsidian = false
# obsidian_vault = "~/Documents/Obsidian/MyVault"
obsidian_note = "IdeaForge/Action Items.md"